datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  emails    Email[]

  @@map("senders")
}

enum EmailStatus {
  SCHEDULED
  SENT
  FAILED
}

model Email {
  id          String      @id @default(uuid())
  status      EmailStatus @default(SCHEDULED)
  subject     String
  body        String
  recipient   String
  senderId    String      @map("sender_id")
  scheduledAt DateTime    @map("scheduled_at")
  sentAt      DateTime?   @map("sent_at")
  jobId       String?     @unique @map("job_id") // Unique mapping to BullMQ job
  error       String?
  etherealUrl String?     @map("ethereal_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("emails")
}

model SlackIntegration {
  id           String   @id @default(uuid())
  tenantId     String   @unique @map("tenant_id")
  accessToken  String?  @map("access_token")
  webhookUrl   String?  @map("webhook_url")
  connectedAt  DateTime @default(now()) @map("connected_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("slack_integrations")
}
