# Server Port
PORT=5000

# Relational Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/outbox_db?schema=public"

# Redis Queue Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch Node
ELASTICSEARCH_NODE=http://localhost:9200

# Queue Worker Concurrency & Rate Limit
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR_PER_SENDER=10

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Slack Integration Credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback

# Frontend Origin URL
FRONTEND_URL=http://localhost:3000

# Ethereal SMTP Config (Leave empty to use auto-generated Ethereal test accounts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
